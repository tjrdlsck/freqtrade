# =================================================================
# Project Sentinel - Robust .gitignore Template
# =================================================================

# --- [1] Sensitive Information (민감 정보 - 최우선 보안) ---
# 모든 설정 파일(v11, dryrun, hyperopt 등 포함)을 일괄 차단합니다.
freqtrade/user_data/config*.json
.env

# --- [2] Database & State Files (데이터베이스 및 상태 파일) ---
# 파일명 중간에 버전이 붙어도 모두 차단합니다.
freqtrade/user_data/*.sqlite*
freqtrade/user_data/*.lock
freqtrade/user_data/hyperopt.lock

# --- [3] Freqtrade Directories (용량이 큰 폴더들) ---
freqtrade/user_data/backtest_results/
freqtrade/user_data/hyperopt_results/
freqtrade/user_data/data/
freqtrade/user_data/freqaimodels/
freqtrade/user_data/plot/

# --- [4] Logs (로그 파일 - 로테이션 파일 포함) ---
# 로그 폴더 내의 모든 내용을 차단하는 것이 가장 안전합니다.
freqtrade/user_data/logs/
*.log*

# --- [5] Python & Environment ---
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/

# --- [6] OS & IDE ---
.DS_Store
.idea/
.vscode/
*.swp